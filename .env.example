# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=replace-with-a-private-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_DEBUG=false
SCHOOL_TIME_ZONE=America/Chicago
SCHOOL=NORTHEAST_ELEMENTARY
GRADE=01
SUPPORTED_GRADES=01,02,03,04,05
# Optional public HTTPS base URL, including a path prefix if the app uses one.
# Set it when the app is behind a reverse proxy that does not preserve HTTPS.
CALENDAR_PUBLIC_BASE_URL=
# Refresh the next fourteen calendar days immediately, then repeat every six hours.
CALENDAR_REFRESH_INTERVAL_SECONDS=21600
# Thumbnail files persist beside DATABASE_PATH by default; optional cache policy.
# THUMBNAIL_CACHE_DIR=/data/thumbnail-cache
# THUMBNAIL_CACHE_TTL_SECONDS=2592000
# THUMBNAIL_CACHE_MAX_BYTES=134217728
BIND_ADDRESS=127.0.0.1
APP_PORT=8000
# Local builds use lunchbox:local. For a published release, set username/lunchbox:1.0.0.
LUNCHBOX_IMAGE=lunchbox:local
